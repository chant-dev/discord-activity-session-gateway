# Discord OAuth token exchange settings used by server helpers.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://127.0.0.1

# Browser Activity settings used by Vite-based clients.
VITE_DISCORD_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_LOCAL_API_BASE_URL=http://localhost:3001
VITE_LOCAL_WS_URL=http://localhost:3001

# Example local server settings.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
